import { Theme } from "../theme.slint";
import { Blink, DashState, Signal } from "state.slint";

/// A telletale symbol on a plate.
///
/// The plate is always on screen, so the driver knows where a symbol sits before
/// it ever lights up. An unlit symbol stays faintly visible; a blinking one dims
/// to the same level instead of vanishing, which reads far calmer at speed than
/// something appearing out of nothing twice a second.
export component Lamp inherits Rectangle {
    in property <image> source;
    in property <bool> active;
    in property <bool> blink;
    in property <color> tint;
    in property <color> plate;
    in property <length> u: 1px;
    in property <angle> rotation: 0deg;

    /// How much of an unlit symbol remains visible.
    property <float> unlit: 0.3;

    background: root.plate;
    border-radius: min(root.width, root.height) * 0.18;
    Image {
        x: root.width * 0.05;
        y: root.height * 0.05;
        width: root.width * 0.9;
        height: root.height * 0.9;
        source: root.source;
        colorize: root.tint;
        transform-rotation: root.rotation;
        opacity: !root.active || (root.blink && !Blink.on) ? root.unlit : 1;
    }
}

export component SegmentBar inherits HorizontalLayout {
    in property <float> ratio;
    in property <color> on-color;
    in property <length> u;
    property <int> filled: round(clamp(ratio, 0, 1) * 8);
    spacing: 4 * u;
    alignment: center;
    for i in 8: Rectangle {
        width: 12 * root.u;
        height: 8 * root.u;
        y: (parent.height - self.height) / 2;
        border-radius: 2 * root.u;
        background: i < root.filled ? root.on-color : Theme.text-disabled;
        opacity: i < root.filled ? 1 : 0.5;
    }
}

export component Level inherits Rectangle {
    in property <image> icon;
    in property <float> ratio;
    in property <string> value;
    in property <bool> warn;
    in property <length> u;
    width: row.preferred-width;
    row := HorizontalLayout {
    spacing: 9 * root.u;
    alignment: center;
    Image {
        width: 22 * root.u;
        height: 22 * root.u;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.warn ? Signal.warn : Theme.text-secondary;
    }
    SegmentBar {
        u: root.u;
        ratio: root.ratio;
        on-color: root.warn ? Signal.warn : Theme.text;
    }
    Text {
        min-width: 3 * 0.6 * 22 * root.u;
        text: root.value;
        font-size: 22 * root.u;
        color: root.warn ? Signal.warn : Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    }
}

export component Clock inherits Text {
    in property <length> u;
    text: DashState.clock;
    font-size: 44 * u;
    color: Theme.text;
    opacity: 0.55;
    letter-spacing: 1.9 * u;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Dots inherits Rectangle {
    property <length> dot: clamp(Ui-height * 0.012, 6px, 10px);
    in property <length> Ui-height;
    height: dots.preferred-height;
    width: dots.preferred-width;
    border-radius: self.height / 2;
    background: Theme.dark ? #0000008c : #0000004d;
    dots := HorizontalLayout {
        padding: root.dot;
        spacing: root.dot;
        for i in DashState.page-count: Rectangle {
            width: root.dot * 2;
            height: root.dot * 2;
            Rectangle {
                width: root.dot;
                height: root.dot;
                border-radius: root.dot / 2;
                background: i == DashState.page-index ? Theme.primary : Theme.text-secondary;
                opacity: i == DashState.page-index ? 1 : 0.45;
            }
            TouchArea {
                clicked => { DashState.select-page(i); }
            }
        }
    }
}
