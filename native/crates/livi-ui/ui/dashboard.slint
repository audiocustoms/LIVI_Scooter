import { ViewAreaMask } from "mask.slint";
import { Theme } from "theme.slint";
import { Gauge, Readout } from "dashboard/gauge.slint";
import { NavFull, NavMini } from "dashboard/nav.slint";
import { Blink, DashState, Signal } from "dashboard/state.slint";
import { Dots, DriveLevels, Lamp, Level } from "dashboard/widgets.slint";

export { CapData, DashState, GaugeData, LabelData, TrailData } from "dashboard/state.slint";

export component Dashboard inherits Rectangle {
    property <float> s: min(root.width / 1280px, root.height / 720px);
    property <length> u: max(0.01, s) * 1px;
    property <length> left: (root.width - 1280 * u) / 2;
    property <length> top: (root.height - 720 * u) / 2;
    property <float> push: max(0, (root.width / u - 1280) / 2);
    property <color> pointer: DashState.has-accent ? DashState.accent : Theme.text;
    property <color> major: DashState.has-accent ? DashState.accent : Theme.text-secondary;
    property <color> shade: Theme.dark ? #0000008c : #ffffffb8;
    property <color> plate: Theme.dark ? #00000099 : #ffffffc7;
    property <bool> blinking: DashState.turn-left || DashState.turn-right || DashState.hazards;
    /// A scooter shows its lamps on plates and large enough to read at a glance;
    /// every other drive type keeps the original size and leaves them off.
    property <float> lamp-arrow: DashState.scooter ? 100 : 51;
    property <float> lamp-row: DashState.scooter ? 100 : 30;
    property <float> lamp-gap: DashState.scooter ? 24 : 21;
    property <length> lamp-y: root.top + (DashState.scooter ? 1 : 12) * root.u;
    /// The drive levels sit in a row of their own under the lamps, on the same
    /// centre line, and are sized like the plates above them.
    property <float> level-cell: 64;
    property <float> level-gap: 14;
    property <float> level-w: 3 * root.level-cell + 2 * root.level-gap;
    /// How far each readout moves towards the middle of the screen, so its plate
    /// stops covering the ticks of the ring beside it. Both move by the same
    /// amount, which keeps the pair symmetrical.
    property <float> readout-shift: 60;
    property <length> swipe-from;
    /// A finger touched the dashboard, whatever the window layer above saw.
    callback woke;

    background: DashState.enabled && DashState.map ? transparent : Theme.background;

    Timer {
        interval: 500ms;
        running: root.blinking;
        triggered => { Blink.on = !Blink.on; }
    }

    // The stand-in map sits where the projection stream would be, so the mask
    // below still blanks whatever falls outside the app's view area. It fills
    // the display and crops the overflow instead of leaving bars, because a
    // 16:9 image on a 5:3 panel would otherwise float in the middle.
    if DashState.enabled && DashState.map && DashState.dev-fake-map: Image {
        width: root.width;
        height: root.height;
        source: @image-url("dev/maps_fake.jpg");
        image-fit: cover;
    }

    if DashState.enabled && DashState.map: ViewAreaMask {
        mask: DashState.mask;
    }

    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.swipe-from = self.mouse-x;
                root.woke();
            } else if (e.kind == PointerEventKind.up) {
                let dx = self.mouse-x - root.swipe-from;
                if (abs(dx) >= 40px && DashState.page-count > 1) {
                    DashState.step(dx < 0 ? 1 : -1);
                }
            }
        }
    }

    if !DashState.enabled: Text {
        text: DashState.placeholder;
        color: Theme.text-secondary;
        font-size: 20px;
    }

    if DashState.enabled && DashState.gauges: Rectangle {
        Gauge {
            x: root.left + (-32 + DashState.ring-shift - root.push) * root.u;
            y: root.top + 60 * root.u;
            u: root.u;
            g: DashState.speed-gauge;
            value-t: DashState.speed-t;
            markers: DashState.speed-markers;
            scale-color: Theme.text-disabled;
            major-color: root.major;
            pointer-color: root.pointer;
            backdrop: DashState.map;
            backdrop-color: root.shade;
        }
        Readout {
            x: round((root.left + (-32 + DashState.ring-shift - root.push + 235 + 34 - 100 + root.readout-shift) * root.u) / 1phx) * 1phx;
            y: round((root.top + (60 + 300 - 65) * root.u) / 1phx) * 1phx;
            width: 200 * root.u;
            height: 130 * root.u;
            u: root.u;
            value: DashState.speed-text;
            caption: DashState.speed-label;
            note: DashState.speed-note;
            to-end: true;
            /// The same plate as the charge readout beside it: a scooter gets a
            /// fixed width both of them share, so the pair stays symmetrical
            /// whatever a value is at the time.
            wide: DashState.scooter;
            min-w: DashState.scooter ? 280 * root.u : 0px;
            backdrop: DashState.map;
            backdrop-color: root.plate;
        }
        Gauge {
            x: root.left + (850 + root.push - DashState.ring-shift) * root.u;
            y: root.top + 60 * root.u;
            u: root.u;
            g: DashState.rpm-gauge;
            value-t: DashState.rpm-t;
            scale-color: Theme.text-disabled;
            major-color: root.major;
            pointer-color: root.pointer;
            backdrop: DashState.map;
            backdrop-color: root.shade;
        }
        Readout {
            x: round((root.left + (850 + root.push - DashState.ring-shift + 235 - 34 - 100 - root.readout-shift) * root.u) / 1phx) * 1phx;
            y: round((root.top + (60 + 300 - 65) * root.u) / 1phx) * 1phx;
            width: 200 * root.u;
            height: 130 * root.u;
            u: root.u;
            value: DashState.scooter ? DashState.charge-text : DashState.gear;
            caption: DashState.scooter ? (DashState.charge-energy != "" ? DashState.charge-energy : DashState.charge-label) : DashState.gear-label;
            wide: DashState.scooter;
            min-w: DashState.scooter ? 280 * root.u : 0px;
            to-end: false;
            backdrop: DashState.map;
            backdrop-color: root.plate;
        }

        Lamp {
            x: root.left + 70 * root.u;
            y: root.top + 1 * root.u;
            width: root.lamp-arrow * root.u;
            height: root.lamp-arrow * root.u;
            u: root.u;
            plate: root.plate;
            source: @image-url("icons/PlayArrow.svg");
            rotation: 180deg;
            tint: Signal.green;
            active: DashState.turn-left || DashState.hazards;
            blink: true;
        }
        Lamp {
            x: root.left + (1210 - root.lamp-arrow) * root.u;
            y: root.top + 1 * root.u;
            width: root.lamp-arrow * root.u;
            height: root.lamp-arrow * root.u;
            u: root.u;
            plate: root.plate;
            source: @image-url("icons/PlayArrow.svg");
            tint: Signal.green;
            active: DashState.turn-right || DashState.hazards;
            blink: true;
        }
        row := HorizontalLayout {
            x: root.left + (640 - (2 * root.lamp-row + 1.5 * root.lamp-gap)) * root.u;
            y: root.lamp-y;
            height: root.lamp-row * root.u;
            spacing: root.lamp-gap * root.u;
            Lamp {
                width: root.lamp-row * root.u;
                height: root.lamp-row * root.u;
                u: root.u;
                plate: root.plate;
                source: @image-url("icons/TelltaleLowBeam.svg");
                tint: Signal.green;
                active: DashState.lights;
            }
            Lamp {
                width: root.lamp-row * root.u;
                height: root.lamp-row * root.u;
                u: root.u;
                plate: root.plate;
                source: @image-url("icons/TelltaleHighBeam.svg");
                tint: Signal.blue;
                active: DashState.high-beam;
            }
            Lamp {
                width: root.lamp-row * root.u;
                height: root.lamp-row * root.u;
                u: root.u;
                plate: root.plate;
                source: @image-url("icons/TelltaleHazard.svg");
                tint: Signal.red;
                active: DashState.hazards;
                blink: true;
            }
            Rectangle {
                width: root.lamp-row * root.u;
                height: root.lamp-row * root.u;
                background: DashState.scooter ? root.plate : transparent;
                border-radius: min(self.width, self.height) * 0.18;
                Image {
                    x: DashState.scooter ? parent.width * 0.05 : 0;
                    y: DashState.scooter ? parent.height * 0.05 : 0;
                    width: DashState.scooter ? parent.width * 0.9 : parent.width;
                    height: DashState.scooter ? parent.height * 0.9 : parent.height;
                    source: @image-url("icons/TelltaleParkingRing.svg");
                    colorize: Signal.red;
                    opacity: DashState.parking-brake ? 1 : (DashState.scooter ? 0.3 : 0);
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: "P";
                    font-size: 9.5 / 24 * root.lamp-row * root.u;
                    font-weight: 700;
                    color: Signal.red;
                    opacity: DashState.parking-brake ? 1 : (DashState.scooter ? 0.3 : 0);
                }
            }
        }
        if DashState.scooter && DashState.drive-level != 0: DriveLevels {
            x: round((root.left + (640 - root.level-w / 2) * root.u) / 1phx) * 1phx;
            y: root.lamp-y + (root.lamp-row + 8) * root.u;
            width: root.level-w * root.u;
            height: root.level-cell * root.u;
            u: root.u;
            cell: root.level-cell * root.u;
            cell-gap: root.level-gap * root.u;
            level: DashState.drive-level;
        }
        if DashState.ambient != "": Text {
            x: root.left + (1210 - root.lamp-arrow - (DashState.scooter ? 24 : 42)) * root.u - self.width;
            y: root.top + 27 * root.u - self.height / 2;
            text: DashState.ambient;
            font-size: 20 * root.u;
            font-weight: 500;
            letter-spacing: 0.5 * root.u;
            color: Theme.text;
        }

        if !DashState.scooter: Level {
            x: root.left + 140 * root.u;
            y: root.top + 660 * root.u;
            height: 24 * root.u;
            u: root.u;
            icon: @image-url("icons/DeviceThermostat.svg");
            ratio: DashState.oil-ratio;
            value: DashState.oil-text;
            warn: DashState.oil-hot;
        }
        if !DashState.scooter: Level {
            x: root.left + 1140 * root.u - self.width;
            y: root.top + 660 * root.u;
            height: 24 * root.u;
            u: root.u;
            icon: DashState.battery ? @image-url("icons/BatteryHorizontal.svg") : @image-url("icons/LocalGasStation.svg");
            ratio: DashState.fuel / 100;
            value: DashState.fuel + "%";
            warn: DashState.fuel-low;
        }
    }

    if DashState.enabled && DashState.gauges && DashState.center == 1: NavMini {
        x: root.left;
        y: root.top;
        width: 1280 * root.u;
        height: 720 * root.u;
        u: root.u;
    }
    if DashState.enabled && DashState.gauges && DashState.center == 2: NavFull {
        x: root.left;
        y: root.top;
        width: 1280 * root.u;
        height: 720 * root.u;
        u: root.u;
    }

    if DashState.enabled && DashState.page-count > 1: Dots {
        Ui-height: root.height;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - clamp(root.height * 0.022, 10px, 18px);
        opacity: DashState.dots-shown ? 1 : 0;
        animate opacity { duration: 220ms; }
    }
}
